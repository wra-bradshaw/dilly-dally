{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dilly-dally",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/worker.ts",
	"placement": { "mode": "smart" },
	"routes": [{ "pattern": "dally.bradshaw.page", "custom_domain": true }],
	"triggers": { "crons": ["*/30 * * * *"] },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dilly-dally",
			"database_id": "eedd7d7b-8631-45a7-bb73-1ba53a1858e5",
			"migrations_dir": "migrations/drizzle"
		}
	],
	"ratelimits": [
		{
			"name": "AVAIL_WRITE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 30, "period": 60 }
		},
		{
			"name": "READ_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 120, "period": 60 }
		},
		{
			"name": "CREATE_EVENT_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] },
		{ "tag": "v2", "deleted_classes": ["RateLimiter"] }
	],
	"observability": {
		"enabled": true,
		"logs": { "enabled": true },
		"traces": { "enabled": true }
	}
}
