{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dilly-dally",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/worker.ts",
	"triggers": { "crons": ["*/30 * * * *"] },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dilly-dally",
			"database_id": "eedd7d7b-8631-45a7-bb73-1ba53a1858e5",
			"migrations_dir": "migrations/drizzle"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
	"observability": {
		"enabled": true,
		"logs": { "enabled": true },
		"traces": { "enabled": true }
	}
}
