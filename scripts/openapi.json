      "WeeklySlotId": {
        "type": "string",
        "pattern": "^(SUN|MON|TUE|WED|THU|FRI|SAT)-([01]\\d|2[0-3]):(00|30)$",
        "description": "Weekly slot id: weekday code plus HH:mm. Monday is MON, Sunday is SUN.",
        "example": "MON-09:30"
      }
    }
