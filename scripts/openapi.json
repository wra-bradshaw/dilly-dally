  "components": {
    "schemas": {
      "CreateEventRequest": {
        "type": "object",
        "properties": {
          "dates": {
            "minItems": 1,
            "maxItems": 31,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "description": "1..31 entries, YYYY-MM-DD, each today (UTC) through today+90 inclusive. Required when mode is dates (the default). Omit or send [] for weekly events."
          },
          "endTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):(00|30)$",
            "example": "17:00"
          },
          "mode": {
            "$ref": "#/components/schemas/EventMode"
          },
          "polls": {
            "description": "Optional 0..10 polls created with the event. Each needs question 1..140 chars and 2..10 unique options 1..80 chars.",
            "maxItems": 10,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreatePollRequest"
            }
          },
          "startTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):(00|30)$",
            "example": "09:00"
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "example": "America/New_York"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "weekdays": {
            "description": "Required when mode is weekly. 1..7 unique entries, 0=Sunday through 6=Saturday. Example [1,3,5] means Mon/Wed/Fri.",
            "maxItems": 7,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Weekday"
            }
          }
        },
        "required": [
          "endTime",
          "startTime",
          "timezone",
          "title"
        ]
      },
      "EventMode": {
        "type": "string",
        "enum": [
          "dates",
          "weekly"
        ],
        "description": "dates picks specific dates; weekly repeats on weekdays.",
        "example": "dates"
      },
      "CreatePollRequest": {
        "type": "object",
        "properties": {
          "allowMultiple": {
            "description": "When true voters may pick multiple options, otherwise single choice.",
            "type": "boolean"
          },
          "options": {
            "minItems": 2,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          }
        },
        "required": [
          "options",
          "question"
        ]
      },
      "Weekday": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6,
        "description": "Day of week, 0=Sunday through 6=Saturday.",
        "example": 1
      },
      "AvailabilityRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "password": {
            "description": "Optional password. Sent only over HTTPS, never stored in plain text.",
            "type": "string",
            "minLength": 4,
            "maxLength": 72
          },
          "slots": {
            "maxItems": 2852,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlotId"
            },
            "description": "Full replace set of slot ids. Date events use YYYY-MM-DDTHH:mm; weekly events use DOW-HH:mm like MON-09:30. Empty array means unavailable everywhere."
          }
        },
        "required": [
          "name",
          "slots"
        ]
      },
      "SlotId": {
        "type": "string",
        "pattern": "^(\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):(00|30)|(SUN|MON|TUE|WED|THU|FRI|SAT)-([01]\\d|2[0-3]):(00|30))$",
        "description": "Slot id in event-timezone wall time. Date events use YYYY-MM-DDTHH:mm; weekly events use DOW-HH:mm like MON-09:30.",
        "example": "2026-10-05T09:30"
      },
      "AddPollOptionRequest": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "label"
        ]
      },
      "PollVoteRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "optionIds": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "description": "Full replace set of option ids for this poll. Empty array clears the vote."
          },
          "password": {
            "description": "Optional password, same identity as availability. Required when the name is password-protected.",
            "type": "string",
            "minLength": 4,
            "maxLength": 72
          }
        },
        "required": [
          "name",
          "optionIds"
        ]
      },
      "SessionRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "password": {
            "description": "Optional password, required when the name is password-protected. Never stored, only used to mint a short-lived session cookie.",
            "type": "string",
            "minLength": 4,
            "maxLength": 72
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateEventResponse": {
        "type": "object",
        "properties": {
          "event": {
            "$ref": "#/components/schemas/Event"
          },
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "event",
          "id",
          "url"
        ],
        "additionalProperties": false
      },
      "Event": {
        "type": "object",
        "properties": {
          "createdAt": {
            "type": "string"
          },
          "dates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Specific dates for dates events; empty array for weekly events."
          },
          "endTime": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/EventMode"
          },
          "startTime": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "weekdays": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Weekday"
            },
            "description": "Weekdays for weekly events, 0=Sunday through 6=Saturday; empty array for dates events."
          }
        },
        "required": [
          "createdAt",
          "dates",
          "endTime",
          "expiresAt",
          "id",
          "mode",
          "startTime",
          "timezone",
          "title",
          "weekdays"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "EventDetailResponse": {
        "type": "object",
        "properties": {
          "bestTimes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "slot": {
                  "type": "string"
                }
              },
              "required": [
                "count",
                "slot"
              ],
              "additionalProperties": false
            }
          },
          "counts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "names": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "slot": {
                  "type": "string"
                }
              },
              "required": [
                "count",
                "names",
                "slot"
              ],
              "additionalProperties": false
            }
          },
          "event": {
            "$ref": "#/components/schemas/Event"
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "name": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": "string"
                }
              },
              "required": [
                "count",
                "name",
                "updatedAt"
              ],
              "additionalProperties": false
            }
          },
          "polls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Poll"
            },
            "description": "Polls for this event, each with public vote counts and voter names."
          },
          "slotUniverse": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "bestTimes",
          "counts",
          "event",
          "participants",
          "polls",
          "slotUniverse"
        ],
        "additionalProperties": false
      },
      "Poll": {
        "type": "object",
        "properties": {
          "allowMultiple": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
